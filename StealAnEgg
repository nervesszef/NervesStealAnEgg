local function AddHoverEffect(button, normalColor, hoverColor)
    button.MouseEnter:Connect(function()
        TweenService:Create(
            button,
            TweenInfo.new(0.2),
            { BackgroundColor3 = hoverColor }
        ):Play()
    end)
    button.MouseLeave:Connect(function()
        TweenService:Create(
            button,
            TweenInfo.new(0.2),
            { BackgroundColor3 = normalColor }
        ):Play()
    end)
end

